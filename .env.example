# Copy this file to .env and replace placeholder values.
# Do not commit .env or real credentials.

# Gemini is the default model provider. Use either GOOGLE_API_KEY or GEMINI_API_KEY.
DB_AGENT_PROVIDER=gemini
GOOGLE_API_KEY=your_gemini_api_key
# GEMINI_API_KEY=your_gemini_api_key
DB_AGENT_MODEL=gemini-3.1-flash-lite
DB_AGENT_EMBEDDING_MODEL=models/gemini-embedding-001

# Optional OpenAI provider:
# DB_AGENT_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_ADMIN_KEY=your_openai_admin_key
# DB_AGENT_MODEL=gpt-4.1-mini
# DB_AGENT_EMBEDDING_MODEL=text-embedding-3-small

# Optional UI server settings:
# DB_AGENT_UI_HOST=127.0.0.1
# DB_AGENT_UI_PORT=8000

# Optional local demo database URLs for config/databases.example.yaml:
# DATABASE_URL_CUSTOMERS=sqlite:///examples/customers.db
# DATABASE_URL_ORDERS=sqlite:///examples/orders.db

# Optional remote database URL example:
# DATABASE_URL_ORDERS=postgresql+psycopg://user:password@localhost:5432/orders

# Fineract example (read-only role created after the stack is up — see fineract/README.md).
# Host port 5433 (compose maps 5433->5432) avoids clashing with a native Postgres on 5432:
DATABASE_URL_FINERACT=postgresql+psycopg://agent_ro:agent_ro_pw@localhost:5433/fineract_default
